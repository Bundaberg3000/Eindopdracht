[{"name": "", "steps": [{"number": 1, "step": "Melt the butter in a large pan over medium-low heat, add the onion, sugar and salt and cook them, stirring frequently, until the onion is golden, about 5-8 minutes.Stir in the beer, scraping up any bits from the bottom of the pan.", "ingredients": [{"id": 1001, "name": "butter", "localizedName": "butter", "image": "butter-sliced.jpg"}, {"id": 11282, "name": "onion", "localizedName": "onion", "image": "brown-onion.png"}, {"id": 19335, "name": "sugar", "localizedName": "sugar", "image": "sugar-in-bowl.png"}, {"id": 14003, "name": "beer", "localizedName": "beer", "image": "beer.jpg"}, {"id": 2047, "name": "salt", "localizedName": "salt", "image": "salt.jpg"}], "equipment": [{"id": 404645, "name": "frying pan", "localizedName": "frying pan", "image": "https://spoonacular.com/cdn/equipment_100x100/pan.png"}], "length": {"number": 8, "unit": "minutes"}}, {"number": 2, "step": "Add the sausages, cabbage and potatoes and simmer, covered, stirring occasionally, for 20 minutes or until the vegetables are tender.", "ingredients": [{"id": 11583, "name": "vegetable", "localizedName": "vegetable", "image": "https://spoonacular.com/cdn/ingredients_100x100/mixed-vegetables.png"}, {"id": 11352, "name": "potato", "localizedName": "potato", "image": "potatoes-yukon-gold.png"}, {"id": 1017063, "name": "sausage", "localizedName": "sausage", "image": "raw-pork-sausage.png"}, {"id": 11109, "name": "cabbage", "localizedName": "cabbage", "image": "cabbage.jpg"}], "equipment": [], "length": {"number": 20, "unit": "minutes"}}, {"number": 3, "step": "Serve the sausages and veggies in big bowls with plenty of the cooking liquid, sprinkled with freshly cracked pepper.", "ingredients": [{"id": 0, "name": "cracked pepper", "localizedName": "cracked pepper", "image": "pepper.jpg"}, {"id": 1017063, "name": "sausage", "localizedName": "sausage", "image": "raw-pork-sausage.png"}], "equipment": [{"id": 404783, "name": "bowl", "localizedName": "bowl", "imag